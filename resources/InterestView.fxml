<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Monthly interest screen. Controller: view.InterestView. -->
<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="view.InterestView" stylesheets="@styles.css">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <children>
        <Label text="Monthly Interest" styleClass="heading"/>
        <Label text="Investment accounts earn 5% per month and Savings accounts earn 0.05% per month." styleClass="hint" wrapText="true"/>
        <HBox spacing="10">
            <children>
                <Label text="Month:"/>
                <ComboBox fx:id="monthBox" onAction="#refresh"/>
                <Label fx:id="statusLabel" styleClass="status-pill"/>
            </children>
        </HBox>
        <TableView fx:id="interestTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn text="Account no." prefWidth="110"/>
                <TableColumn text="Customer" prefWidth="200"/>
                <TableColumn text="Type" prefWidth="90"/>
                <TableColumn text="Balance" prefWidth="130"/>
                <TableColumn text="Monthly rate" prefWidth="100"/>
                <TableColumn text="Interest due" prefWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="No active interest-bearing accounts."/>
            </placeholder>
        </TableView>
        <Label fx:id="totalLabel" styleClass="total"/>
        <Button text="Pay interest for selected month" styleClass="primary" onAction="#payInterest"/>
    </children>
</VBox>
