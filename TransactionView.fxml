<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Transactions screen: deposit, withdraw, transfer and history. Controller: view.TransactionView. -->
<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="view.TransactionView" stylesheets="@styles.css">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>
    <children>
        <Label text="Transactions" styleClass="heading"/>
        <HBox spacing="10">
            <children>
                <Label text="Account:"/>
                <ComboBox fx:id="accountBox" promptText="Choose an account" prefWidth="420" onAction="#handleAccountChanged"/>
            </children>
        </HBox>
        <Label fx:id="accountInfoLabel" styleClass="account-info" wrapText="true" maxWidth="1.7976931348623157E308" minHeight="-Infinity"/>
        <TabPane tabClosingPolicy="UNAVAILABLE" prefHeight="210" minHeight="210">
            <tabs>
                <Tab text="Deposit">
                    <content>
                        <GridPane hgap="12" vgap="10" styleClass="form">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>
                            <columnConstraints>
                                <ColumnConstraints minWidth="170" prefWidth="170" maxWidth="170"/>
                                <ColumnConstraints hgrow="ALWAYS" maxWidth="420"/>
                            </columnConstraints>
                            <children>
                                <Label text="Amount *" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="depositAmountField" promptText="Amount in BWP" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Button text="Deposit" styleClass="primary" onAction="#deposit" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            </children>
                        </GridPane>
                    </content>
                </Tab>
                <Tab text="Withdraw">
                    <content>
                        <GridPane hgap="12" vgap="10" styleClass="form">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>
                            <columnConstraints>
                                <ColumnConstraints minWidth="170" prefWidth="170" maxWidth="170"/>
                                <ColumnConstraints hgrow="ALWAYS" maxWidth="420"/>
                            </columnConstraints>
                            <children>
                                <Label text="Amount *" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="withdrawAmountField" promptText="Amount in BWP" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Button text="Withdraw" styleClass="primary" onAction="#withdraw" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                <Label text="Savings accounts do not allow withdrawals." styleClass="hint" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            </children>
                        </GridPane>
                    </content>
                </Tab>
                <Tab text="Transfer">
                    <content>
                        <GridPane hgap="12" vgap="10" styleClass="form">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>
                            <columnConstraints>
                                <ColumnConstraints minWidth="170" prefWidth="170" maxWidth="170"/>
                                <ColumnConstraints hgrow="ALWAYS" maxWidth="420"/>
                            </columnConstraints>
                            <children>
                                <Label text="To account *" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <ComboBox fx:id="targetBox" promptText="Destination account" maxWidth="1.7976931348623157E308" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="Amount *" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="transferAmountField" promptText="Amount in BWP" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                <Button text="Transfer" styleClass="primary" onAction="#transfer" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            </children>
                        </GridPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
        <Label text="Transaction history" styleClass="heading"/>
        <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn text="Date" prefWidth="140"/>
                <TableColumn text="Type" prefWidth="100"/>
                <TableColumn text="Amount" prefWidth="120"/>
                <TableColumn text="Balance after" prefWidth="130"/>
                <TableColumn text="Description" prefWidth="240"/>
                <TableColumn text="Transaction ID" prefWidth="150"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Choose an account to see its transaction history."/>
            </placeholder>
        </TableView>
    </children>
</VBox>
